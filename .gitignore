# Generated by Cargo
# will have compiled files and executables
/target/

# Bytecode generated by the Python tooling tests
/tools/__pycache__/

# These are backup files generated by rustfmt
**/*.rs.bk

# SWF debug symbols
*.swd

# Flash recovery files
RECOVER_*.fla

# Jetbrains tools (CLion, IntelliJ, etc)
/.idea

# Mac junk
.DS_Store

# A developers local Flash Player harness config
.flash_players.toml
